# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: every VITE_* variable is inlined into the JavaScript bundle and is
# therefore PUBLIC. Anyone who loads the page can read these values.
# The TURN credential below is a *development* credential. For production,
# issue short-lived TURN credentials from a backend (TURN REST API /
# coturn `use-auth-secret`) and fetch them at runtime instead.
# ─────────────────────────────────────────────────────────────────────────────

# ScaleDrone channel used for signaling + presence
VITE_SCALEDRONE_CHANNEL_ID=EoIG3R1I4JdyS4L1

# Comma-separated STUN URLs (Google's servers are STUN only — never TURN)
VITE_STUN_SERVER=stun:dev.aahlaad.in:3401,stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN relay fallback (comma-separated URLs allowed, e.g. add ?transport=tcp)
VITE_TURN_SERVER=turn:dev.aahlaad.in:3401
VITE_TURN_USERNAME=4133894400
VITE_TURN_CREDENTIAL=saarathy4qMCYoJ20rLihYzne4Cb9DJByVs=

# P2P-first strategy
#  DIRECT_P2P_TIMEOUT_MS: how long local TURN relay candidates are withheld from
#                         the remote peer while direct (host/srflx) paths are tried.
#  HOST_ONLY_WINDOW_MS:   optional extra window during which STUN (srflx) candidates
#                         are also withheld so host→host LAN pairs get a head start.
#                         0 = send srflx immediately (recommended, see README).
#  ICE_FALLBACK_MODE:     "gated" (default) or "native" (send every candidate at once).
VITE_DIRECT_P2P_TIMEOUT_MS=3000
VITE_HOST_ONLY_WINDOW_MS=0
VITE_ICE_FALLBACK_MODE=gated
# If > 0: while a peer is on a TURN relay, periodically ICE-restart to re-probe direct P2P.
VITE_RELAY_UPGRADE_PROBE_MS=0

# Optional Web Push relay (see server/push-server.mjs). Leave empty to disable push.
VITE_PUSH_SERVER_URL=
VITE_VAPID_PUBLIC_KEY=

# ERROR | WARN | INFO | DEBUG
VITE_LOG_LEVEL=INFO
