{
  "name": "mesh-voip",
  "private": true,
  "version": "1.0.0",
  "description": "P2P-first WebRTC mesh VoIP (1:1, group, live) with ScaleDrone signaling",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --mode lan",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/two-peer.mjs",
    "push-server": "node server/push-server.mjs",
    "vapid": "web-push generate-vapid-keys",
    "test:resilience": "node tests/e2e/resilience.mjs",
    "test:screens": "node tests/e2e/screens.mjs",
    "test:features": "node tests/e2e/features.mjs",
    "test:rooms": "node tests/e2e/rooms.mjs",
    "test:pwa": "node tests/e2e/pwa.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "node-turn": "^0.0.6",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^3.2.0",
    "web-push": "^3.6.7"
  }
}
